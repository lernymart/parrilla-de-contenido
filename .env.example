# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# OpenRouter — modelo usado: openai/gpt-4o-mini
OPENROUTER_API_KEY=

# SerpAPI — investigación de competencia
SERPAPI_API_KEY=

# Opcional (aparece en headers de OpenRouter)
NEXT_PUBLIC_APP_URL=http://localhost:3000
